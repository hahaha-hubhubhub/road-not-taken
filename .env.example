# ===== 没走的路 / Road Not Taken 本地环境变量 =====
# 复制为 .env 后按需填写；.env 已在 .gitignore 中，不会提交。

# ---- StepFun（阶跃星辰）----
# 提供 Key 有两种方式，任选其一：
#
#   方式一（本机演示最省事）：这里留空，npm start 后打开页面，
#     点右上角「设置」把 Key 填进去。Key 只存在这台设备的浏览器里，
#     每次生成时随请求头 X-Stepfun-Api-Key 发给本地服务端。
#
#   方式二（部署到服务器时用）：填在下面，前端无需设置。
# STEPFUN_API_KEY=
#
# 两种方式可以同时存在：页面设置的 Key 优先于这里的。
STEPFUN_BASE_URL=https://api.stepfun.com/v1
STEPFUN_MODEL=step-5-preview
STEPFUN_MAX_TOKENS=8000
STEPFUN_TIMEOUT_MS=60000
# 推理强度 low / medium / high。
# 注意：思考过程也计入 completion_tokens，max_tokens 必须留够（<1600 会截断正文）。
# 实测（step-5-preview，同一 prompt）：medium ≈ 21-34s，low ≈ 28-41s，high ≈ 39s
STEPFUN_REASONING_EFFORT=medium
# 若现场必须压到 15 秒内，可改用 step-3.7-flash（实测 10-16s，质量略降）；
# 前端「设置」里也能临时切模型（请求头 X-Stepfun-Model 优先）。
# STEPFUN_MODEL=step-3.7-flash

# MOCK_LLM=1 时完全用预生成案例跑流程（断网演示），不调用模型；默认 0
MOCK_LLM=0

# ---- 服务 ----
PORT=8787
# 对外访问地址（用于小票二维码里的分享链接）；本机演示用 localhost 即可
PUBLIC_WEB_URL=http://localhost:8787
# 跨域白名单：静态托管的前端跨域访问时填具体域名，演示可用 *
ALLOWED_ORIGIN=*

# ---- 演示 / 演示模式 ----
# 无硬件时模拟一次打印的耗时（毫秒）
SIMULATED_PRINT_MS=2600
# 胶囊授权后等待设备传感器上报的最长时间（毫秒）；真机须独立硬件超时停机
CAPSULE_TIMEOUT_MS=30000
# session 数据保留时长（小时），到期自动清除（OPS-03）
SESSION_TTL_HOURS=24

# ---- 打印服务（B 路：笔记本驱动打印，见 docs/PRD.md §6.1）----
# 运行 npm run print-service 时读取。输出目标三选一：
#   file    写入 out/receipt-<id>.bin —— 默认，没有打印机也能联调
#   device  写入字符设备，需配合 PRINT_DEVICE
#   stdout  写到标准输出，可管道给 lp -d <打印机名>
PRINT_TARGET=file
# device 模式的打印机路径：
#   macOS: ls /dev/cu.*   常见 /dev/cu.usbserial-XXXX
#   Linux: /dev/usb/lp0（USB 打印机类）或 /dev/ttyUSB0（串口）
# PRINT_DEVICE=/dev/cu.usbserial-14410
# 串口波特率；USB 打印机类设备（/dev/usb/lp0）忽略此项
PRINT_BAUD=115200
# 分块写入参数。含三张插画的小票约 73KB，串口不分块会因缓冲溢出丢数据
PRINT_CHUNK=512
PRINT_CHUNK_DELAY_MS=2

# ---- 图片生成（AI-03，见 docs/ARCHITECTURE.md §10）----
# gpt-image-2 走 models-proxy 网关，与文本用的 StepFun 主站不是同一个 base URL。
# 留空则生图自动关闭：手机端回落预置插画，不影响取票和胶囊流程。
# 注意：这个 Key 只放 .env，不要提交，也不要在页面设置里填（会进浏览器存储）。
# IMAGE_API_KEY=
IMAGE_BASE_URL=https://models-proxy.stepfun-inc.com/v1
IMAGE_MODEL=gpt-image-2
# 单张超时。实测单张约 25s，三张并行约 34s；并行时网关排队可能更慢，给到 90s
IMAGE_TIMEOUT_MS=90000
