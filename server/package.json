{
  "name": "road-not-taken-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "没走的路 / Road Not Taken — 服务端：LLM 生成编排 + session 状态机 + 硬件设备网关",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "serve": "node dist/index.js",
    "mock-device": "tsx src/device/mockDevice.ts",
    "print-service": "tsx src/device/printService.ts",
    "img2bit": "tsx src/device/img2bit.ts",
    "receipt-preview": "tsx scripts/previewReceipt.ts",
    "receipt-html": "tsx scripts/receiptToHtml.ts",
    "browser-check": "tsx scripts/browserCheck.ts",
    "smoke": "tsx scripts/smoke.ts",
    "capsule-check": "tsx scripts/capsuleCheck.ts",
    "try-llm": "tsx scripts/tryLlm.ts",
    "make-preset-images": "tsx scripts/makePresetImages.ts",
    "sample-receipt": "tsx scripts/makeSampleReceipt.ts",
    "thermalize-existing": "tsx scripts/thermalizeExisting.ts",
    "check-thermal": "tsx scripts/checkThermalRouting.ts",
    "test:story-quality": "npm run build && node --test tests/story-quality.test.mjs"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "iconv-lite": "^0.6.3",
    "openai": "^4.67.3",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/iconv-lite": "^0.0.1",
    "@types/node": "^22.7.5",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
